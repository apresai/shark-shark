{
  "name": "shark-shark",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:open-next": "npm_config_userconfig=/dev/null npm_config_allow_scripts= npx @opennextjs/aws build && node scripts/assert-sharp-bundle.mjs .open-next/image-optimization-function",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "deploy": "npm run build:open-next && cd infra && npx cdk deploy",
    "deploy:diff": "npm run build:open-next && cd infra && npx cdk diff"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1068.0",
    "@aws-sdk/util-dynamodb": "^3.996.4",
    "@opennextjs/aws": "3.10.4",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "fast-check": "^4.8.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24"
  }
}
