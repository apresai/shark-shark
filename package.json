{
  "name": "shark-shark",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:open-next": "npm_config_userconfig=/dev/null npm_config_allow_scripts= ./node_modules/.bin/open-next build && node scripts/assert-sharp-bundle.mjs .open-next/image-optimization-function",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "deploy": "npm run build:open-next && cd infra && npx cdk deploy",
    "deploy:diff": "npm run build:open-next && cd infra && npx cdk diff"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1068.0",
    "@aws-sdk/util-dynamodb": "^3.996.4",
    "@opennextjs/aws": "4.1.8",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "uuid": "^13.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "fast-check": "^4.8.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@babel/core": "7.29.6",
    "ajv@6": "6.14.0",
    "body-parser": "2.3.0",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "flatted": "3.4.2",
    "js-yaml@3": "3.15.2",
    "js-yaml@4": "4.3.2",
    "minimatch@3": "3.1.4",
    "minimatch@8": "8.0.6",
    "minimatch@9": "^9.0.7",
    "nanoid@3": "3.3.18",
    "picomatch@2": "2.3.2",
    "picomatch@4": "4.0.4",
    "postcss@8": "8.5.23",
    "sharp": "0.35.5"
  }
}
